# Cloudflare Workers Assets header rules. Copied to public/_headers by build.mjs.
#
# The CSP exists to make the embed hosts explicit. polislop frames third-party
# players from four providers, and the failure this file prevents is a future
# header change quietly blocking one of them and leaving readers with empty
# rectangles where the ads should be. Every host below is here because a
# specific embed needs it:
#
#   YouTube    frame  www.youtube-nocookie.com
#   X          script platform.twitter.com  frame platform.twitter.com
#   Instagram  script platform.instagram.com  frame www.instagram.com
#   Facebook   script connect.facebook.net  frame www.facebook.com, staticxx.facebook.com
#
# 'unsafe-inline' is required for both script and style: the page's own logic is
# a single inline <script>, and all four providers inject inline styles.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://platform.twitter.com https://cdn.syndication.twimg.com https://platform.instagram.com https://www.instagram.com https://connect.facebook.net https://staticxx.facebook.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://platform.twitter.com https://*.cdninstagram.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://*.twimg.com https://*.cdninstagram.com https://*.fbcdn.net https://scontent.cdninstagram.com https://www.facebook.com https://platform.twitter.com https://syndication.twitter.com https://i.ytimg.com; media-src 'self' https://*.cdninstagram.com https://*.fbcdn.net; connect-src 'self' https://graph.facebook.com https://api.instagram.com https://syndication.twitter.com https://cdn.syndication.twimg.com https://*.cdninstagram.com https://*.facebook.com; frame-src https://www.youtube-nocookie.com https://www.youtube.com https://platform.twitter.com https://syndication.twitter.com https://www.instagram.com https://platform.instagram.com https://www.facebook.com https://web.facebook.com https://staticxx.facebook.com; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
